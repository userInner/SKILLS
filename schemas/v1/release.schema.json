{
  "$id": "https://effecta.dev/schemas/v1/release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "effecta.dev/v1"},
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "mediaType": {"minLength": 1, "type": "string"},
        "path": {"minLength": 1, "type": "string"}
      },
      "required": ["path", "digest", "mediaType"],
      "type": "object"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "declared": {"type": "boolean"},
        "runtimes": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}
      },
      "required": ["declared", "runtimes"],
      "type": "object"
    },
    "content": {
      "additionalProperties": false,
      "properties": {
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "fileCount": {"minimum": 1, "type": "integer"},
        "totalBytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["digest", "fileCount", "totalBytes"],
      "type": "object"
    },
    "dependencies": {
      "additionalProperties": false,
      "properties": {
        "items": {"items": {"type": "object"}, "type": "array"},
        "status": {"enum": ["declared", "not-declared"]}
      },
      "required": ["status", "items"],
      "type": "object"
    },
    "kind": {"const": "CapabilityRelease"},
    "license": {
      "additionalProperties": false,
      "properties": {
        "redistribution": {"enum": ["allowed", "review-required", "unknown"]},
        "spdx": {"minLength": 1, "type": "string"}
      },
      "required": ["spdx", "redistribution"],
      "type": "object"
    },
    "packageId": {"minLength": 1, "type": "string"},
    "permissions": {
      "additionalProperties": false,
      "properties": {
        "commands": {"items": {"type": "object"}, "type": "array"},
        "filesystem": {"items": {"type": "object"}, "type": "array"},
        "network": {"items": {"type": "object"}, "type": "array"},
        "status": {"enum": ["declared", "not-declared"]}
      },
      "required": ["status", "filesystem", "network", "commands"],
      "type": "object"
    },
    "releaseId": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "security": {
      "additionalProperties": false,
      "properties": {
        "staticScan": {
          "additionalProperties": false,
          "properties": {
            "findings": {"items": {"type": "object"}, "type": "array"},
            "status": {"minLength": 1, "type": "string"}
          },
          "required": ["status", "findings"],
          "type": "object"
        }
      },
      "required": ["staticScan"],
      "type": "object"
    },
    "smokeTests": {"items": {"type": "object"}, "type": "array"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "path": {"minLength": 1, "type": "string"},
        "repository": {"pattern": "^[^/]+/[^/]+$", "type": "string"},
        "url": {"format": "uri", "type": "string"}
      },
      "required": ["repository", "path", "commit", "url"],
      "type": "object"
    },
    "status": {"enum": ["direct", "extracted", "needs-review"]}
  },
  "required": ["apiVersion", "kind", "packageId", "releaseId", "source", "content", "license", "compatibility", "dependencies", "permissions", "artifact", "security", "smokeTests", "status"],
  "title": "Effecta CapabilityRelease v1",
  "type": "object"
}
